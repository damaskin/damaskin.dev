# damaskin.dev bridge log: 14 days. Installed by setup.sh as /etc/logrotate.d/damaskin-bridge.
/var/log/nginx/damaskin/*.log {
	daily
	rotate 14
	missingok
	notifempty
	compress
	delaycompress
	create 0640 www-data adm
	sharedscripts
	postrotate
		invoke-rc.d nginx rotate >/dev/null 2>&1
	endscript
}

# /var/log is root:syslog 775 on Ubuntu — logrotate refuses it without `su`.
/var/log/damaskin-bridge.log {
	su root syslog
	monthly
	rotate 3
	missingok
	notifempty
	compress
}
